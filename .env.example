# Solana RPC — use a dedicated endpoint in production (Helius, QuickNode, etc.)
# The public mainnet endpoint below works for testing but is rate-limited.
NEXT_PUBLIC_RPC_URL=https://api.mainnet-beta.solana.com
NEXT_PUBLIC_RPC_WS_URL=wss://api.mainnet-beta.solana.com
NEXT_PUBLIC_NETWORK=mainnet

# Umbra Protocol
NEXT_PUBLIC_UMBRA_INDEXER_URL=/api/indexer-proxy
NEXT_PUBLIC_UMBRA_RELAYER_URL=https://relayer.api.umbraprivacy.com

# Token mints (mainnet)
NEXT_PUBLIC_USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
NEXT_PUBLIC_SOL_MINT=So11111111111111111111111111111111111111112

# Link expiry in days
NEXT_PUBLIC_LINK_EXPIRY_DAYS=7

# Supabase — optional, enables link metadata persistence
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Service role key — server-only, bypasses RLS. NEVER prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Sweep destination: remaining SOL after a claim is swept here
NEXT_PUBLIC_OVERAGE_WALLET=your_solana_wallet_address

# x402 private API demo — optional
# Fund NEXT_PUBLIC_X402_SERVER_ADDRESS with mainnet SOL before using
X402_SERVER_PRIVATE_KEY=your_base58_server_keypair   # server-only
NEXT_PUBLIC_X402_SERVER_ADDRESS=your_server_pubkey

# Set to true to enable console logging in development
NEXT_PUBLIC_DEBUG=false
