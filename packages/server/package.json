{
  "name": "@veilpay/server",
  "version": "0.1.0",
  "description": "Server-side helpers for accepting private x402 payments via the Umbra ZK shielded pool",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist", "sql"],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean"
  },
  "keywords": ["x402", "veilpay", "umbra", "solana", "privacy", "payments"],
  "license": "MIT",
  "peerDependencies": {
    "@solana/web3.js": "^1.95.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.0.0"
  },
  "devDependencies": {
    "@solana/web3.js": "^1.98.4",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  }
}
